{
  "name": "bd-geo-service",
  "version": "1.0.0",
  "description": "Bangladesh administrative geography reference-data service (Division, District, Upazila, Union, Post Office).",
  "main": "index.js",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node --import ./src/shared/observability/tracing-preload.js index.js",
    "dev": "node scripts/dev.mjs",
    "dev:api": "node --watch --import ./src/shared/observability/tracing-preload.js index.js",
    "dev:web": "npm --prefix ../web run dev",
    "build:web": "npm --prefix ../web run build",
    "lint:web": "npm --prefix ../web run lint",
    "seed": "node src/scripts/seed.js",
    "dataset:build": "node src/scripts/buildDataset.js",
    "dataset:validate": "node src/scripts/validateDataset.js",
    "db:indexes": "node src/scripts/ensureIndexes.js",
    "test": "node --test"
  },
  "keywords": [
    "bangladesh",
    "geo",
    "division",
    "district",
    "upazila",
    "union"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@opentelemetry/exporter-trace-otlp-http": "^0.223.0",
    "@opentelemetry/instrumentation-express": "^0.71.1",
    "@opentelemetry/instrumentation-http": "^0.223.0",
    "@opentelemetry/instrumentation-mongodb": "^0.76.0",
    "@opentelemetry/instrumentation-redis": "^0.71.0",
    "@opentelemetry/resources": "^2.12.0",
    "@opentelemetry/sdk-node": "^0.223.0",
    "@prometheus-io/client": "^0.16.1",
    "compression": "^1.7.5",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "hpp": "^0.2.3",
    "mongoose": "^8.12.1",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "rate-limit-redis": "^4.3.1",
    "redis": "^6.3.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "mongodb-memory-server": "^11.3.0"
  }
}
