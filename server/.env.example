NODE_ENV=

# MongoDB connection string
MONGODB_URL=

# Comma-separated allowlist. Use * only for local development.
CORS_ORIGINS=

# Required when NODE_ENV=production. At least 16 characters.
ADMIN_API_KEY=

# Request limits
MAX_JSON_SIZE=
# Admin dataset imports can be much larger than normal API requests.
ADMIN_IMPORT_MAX_SIZE=
RATE_LIMIT_WINDOW_MS=
RATE_LIMIT_MAX=

# Set to true only behind a trusted reverse proxy / load balancer
TRUST_PROXY=

LOG_LEVEL=
DATASET_VERSION=

# Prometheus metrics. Set METRICS_TOKEN to require a bearer token on /metrics.
METRICS_ENABLED=
# METRICS_TOKEN=change-me-to-a-long-random-secret

# Optional Redis. When set, rate limiting is shared across instances and
# cache invalidation is broadcast to every instance.
# REDIS_URL=redis://127.0.0.1:6379
REDIS_KEY_PREFIX=
CACHE_INVALIDATION_CHANNEL=
# Optional OpenTelemetry tracing. Spans are exported over OTLP/HTTP.
# OTEL_EXPORTER_OTLP_ENDPOINT defaults to http://localhost:4318.
OTEL_ENABLED=
OTEL_SERVICE_NAME=
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
