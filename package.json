{
  "name": "bd-geo-service-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Bangladesh administrative geography API and console.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "setup": "npm --prefix server install && npm --prefix web install",
    "dev": "node server/scripts/dev.mjs",
    "dev:api": "npm --prefix server run dev:api",
    "dev:web": "npm --prefix web run dev",
    "start": "npm --prefix server start",
    "start:web": "npm --prefix web start",
    "build:web": "npm --prefix web run build",
    "lint:web": "npm --prefix web run lint",
    "test": "npm --prefix server test",
    "seed": "npm --prefix server run seed --",
    "dataset:build": "npm --prefix server run dataset:build --",
    "dataset:validate": "npm --prefix server run dataset:validate --",
    "db:indexes": "npm --prefix server run db:indexes"
  }
}
